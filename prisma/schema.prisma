generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: pooled (PgBouncer/transaction mode) — used at runtime by
  // the app, safe for serverless functions that open/close connections
  // constantly. DIRECT_URL: unpooled — `prisma migrate deploy` needs a
  // direct connection (advisory locks don't work reliably through a
  // transaction-mode pooler). Locally, both can point at the same
  // Postgres instance; only hosted pooled setups (e.g. Supabase) need
  // them to actually differ. Falls back to DATABASE_URL when DIRECT_URL
  // isn't set, so local dev doesn't need a second variable.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN   // manages the whole system
  MANAGER // manages resources (rooms/equipment) and can see all bookings
  USER    // can only manage their own bookings
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  // Non-null only while "Try as Admin" has this account's role temporarily
  // elevated to ADMIN — remembers what to restore on exit, and is what
  // proves *this* mechanism did the elevation (never touched for a real
  // ADMIN/MANAGER account, so it can't be used to silently demote one).
  previewRole  Role?
  locale       String    @default("en") // "pt-BR" | "en" — UI language, set via PATCH /users/me
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]

  @@map("users")
}

model Resource {
  id          String    @id @default(uuid())
  name        String
  description String?
  capacity    Int       @default(1)
  location    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  bookings    Booking[]

  @@map("resources")
}

model Booking {
  id         String        @id @default(uuid())
  startTime  DateTime
  endTime    DateTime
  status     BookingStatus @default(CONFIRMED)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  resourceId String
  resource   Resource      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  // Speeds up the conflict-detection query (same resource, overlapping window)
  @@index([resourceId, startTime, endTime])
  @@map("bookings")
}
