PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_api?schema=public"
# Only needed against a pooled host (e.g. Supabase's PgBouncer) where
# `prisma migrate deploy` needs an unpooled connection — see schema.prisma.
# Locally, this can be left unset; it falls back to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/booking_api?schema=public"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
