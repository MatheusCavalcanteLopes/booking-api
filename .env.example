PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_api?schema=public"
# Only needed against a pooled host (e.g. Supabase's PgBouncer) where
# `prisma migrate deploy` needs an unpooled connection — see schema.prisma.
# Locally, this can be left unset; it falls back to DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/booking_api?schema=public"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- prisma/seed.ts (local development only — never set ALLOW_PRODUCTION_SEED
# in a real deployment) ---
# Password for the seeded admin@example.com account. If unset, the script
# falls back to a hardcoded dev-only default — fine locally, never in a
# shared or public environment.
SEED_ADMIN_PASSWORD=AdminPass123
# The seed script refuses to run when NODE_ENV=production unless this is
# also set to "true". Leave unset/absent outside of local development.
ALLOW_PRODUCTION_SEED=false
